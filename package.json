{
  "name": "coagent-monorepo",
  "version": "1.0.0",
  "description": "CoAgent - Framework modular de orquestração multiagente de IA",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:rust",
    "build:ts": "tsc -b",
    "build:rust": "cargo build --manifest-path apps/cli-rust/Cargo.toml",
    "build:rust-release": "cargo build --release --manifest-path apps/cli-rust/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "cli": "apps/cli-rust/target/debug/coagent.exe",
    "cli:node": "node apps/cli/dist/index.js",
    "start:backend": "node apps/dashboard/dist/server.js"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
